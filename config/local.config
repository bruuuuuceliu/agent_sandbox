APP_ENV=local
MANAGER_PORT=15180
TARGET_KUBE_CONTEXT=kind-sandbox-local
GVISOR_RUNTIME_CLASS=gvisor
MAX_SANDBOXES=10
SANDBOX_CPU_REQUEST=250m
SANDBOX_MEMORY_REQUEST=256Mi
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512Mi
AGENT_CHECK_INTERVAL=15s
AGENT_CHECK_TIMEOUT=5s
NATS_CLIENT_PORT=15181
NATS_MONITOR_PORT=15182
NATS_URL=nats://${NATS_USERNAME}:${NATS_PASSWORD}@127.0.0.1:15181
